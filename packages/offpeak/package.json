{
  "name": "@liming999/offpeak",
  "version": "0.2.1",
  "description": "开启后会在空闲时段发送信息，省钱",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiteEnglish10/DSHCordis.git",
    "directory": "packages/offpeak"
  },
  "homepage": "https://github.com/SiteEnglish10/DSHCordis#readme",
  "bugs": {
    "url": "https://github.com/SiteEnglish10/DSHCordis/issues"
  }
}
